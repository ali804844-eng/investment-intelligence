# Copy to .env and fill in. NEVER commit .env. Secrets are read only by the server/worker, never sent to the browser.

# --- Core ---
APP_ENV=production
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(48))"
SECRET_KEY=
POSTGRES_PASSWORD=
# For local (non-docker) runs set DATABASE_URL directly:
# DATABASE_URL=postgresql+psycopg://ii:password@localhost:5432/ii
COOKIE_SECURE=true                 # true when served over HTTPS (required in production)
CORS_ORIGINS=https://your-domain.example
ALLOW_REGISTRATION=false           # first account can always be created; set true to allow more sign-ups

# --- AI agent (optional; deterministic mode without it) ---
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=claude-opus-5-5
ANTHROPIC_EFFORT=medium
ANTHROPIC_INPUT_PRICE=4.0          # USD per 1M input tokens, for cost estimates
ANTHROPIC_OUTPUT_PRICE=20.0

# --- Data providers (all optional; each one you add replaces SAMPLE data for its capability) ---
SEC_USER_AGENT=                    # e.g. "Jane Doe jane@example.com" (SEC fair-access policy) - free, US filings
TIINGO_API_KEY=                    # end-of-day prices (free tier available)
ALPHAVANTAGE_API_KEY=              # prices fallback, news & sentiment, earnings calendar (free tier: ~25 calls/day)
FRED_API_KEY=                      # macro & rates (free)
ENABLE_FRANKFURTER=true            # ECB reference FX rates (no key)
ENABLE_SAMPLE_DATA=true            # synthetic SAMPLE universe; set false once real data is configured

# --- Email notifications (optional) ---
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM=

# --- Worker ---
WORKER_POLL_SECONDS=5
WORKER_STALE_AFTER_SECONDS=900

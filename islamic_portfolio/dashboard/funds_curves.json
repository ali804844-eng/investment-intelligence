ue": 172.76}, {"month": "2024-03", "key": "mom_4_3", "value": 182.38}, {"month": "2024-04", "key": "mom_4_3", "value": 169.02}, {"month": "2024-05", "key": "mom_4_3", "value": 187.43}, {"month": "2024-06", "key": "mom_4_3", "value": 212.37}, {"month": "2024-07", "key": "mom_4_3", "value": 201.98}, {"month": "2024-08", "key": "mom_4_3", "value": 199.54}, {"month": "2024-09", "key": "mom_4_3", "value": 182.09}, {"month": "2024-10", "key": "mom_4_3", "value": 186.05}, {"month": "2024-11", "key": "mom_4_3", "value": 181.86}, {"month": "2024-12", "key": "mom_4_3", "value": 182.54}, {"month": "2025-01", "key": "mom_4_3", "value": 162.9}, {"month": "2025-02", "key": "mom_4_3", "value": 174.48}, {"month": "2025-03", "key": "mom_4_3", "value": 156.73}, {"month": "2025-04", "key": "mom_4_3", "value": 158.31}, {"month": "2025-05", "key": "mom_4_3", "value": 167.14}, {"month": "2025-06", "key": "mom_4_3", "value": 182.95}, {"month": "2025-07", "key": "mom_4_3", "value": 191.52}, {"month": "2025-08", "key": "mom_4_3", "value": 195.92}, {"month": "2025-09", "key": "mom_4_3", "value": 209.39}, {"month": "2025-10", "key": "mom_4_3", "value": 210.85}, {"month": "2025-11", "key": "mom_4_3", "value": 217.27}, {"month": "2025-12", "key": "mom_4_3", "value": 222.58}, {"month": "2026-01", "key": "mom_4_3", "value": 233.63}, {"month": "2026-02", "key": "mom_4_3", "value": 254.72}, {"month": "2026-03", "key": "mom_4_3", "value": 241.15}, {"month": "2026-04", "key": "mom_4_3", "value": 254.03}, {"month": "2026-05", "key": "mom_4_3", "value": 278.45}, {"month": "2026-06", "key": "mom_4_3", "value": 273.24}, {"month": "2026-07", "key": "mom_4_3", "value": 266.61}, {"month": "2026-08", "key": "mom_4_3", "value": 287.57}, {"month": "2026-09", "key": "mom_4_3", "value": 292.74}, {"month": "2026-10", "key": "mom_4_3", "value": 306.15}, {"month": "2026-11", "key": "mom_4_3", "value": 288.48}], "meta": [{"label": "funds_compare.py", "value": "\"\"\"Islamic funds vs our strategies over the last 5 years (end Oct-2021 -> Nov-2026), total return.\nFunds: Alpha Vantage monthly adjusted closes (distributions reinvested, net of fund fees).\nStrategies: weekly backtest on stitched data (data_2020 + data_gap + data), approx. distributions.\"\"\"\nimport json, warnings\nfrom pathlib import Path\nimport numpy as np, pandas as pd\nwarnings.filterwarnings(\"ignore\")\nimport backtest as bt\nimport robust_strategy as rs\nHERE = Path(__file__).parent\n\nFUNDS = {  # ticker: (name, type, fee %, note)\n    \"SPUS\": (\"SP Funds S&P 500 الشرعي\", \"صندوق مؤشر – أسهم أمريكية\", 0.45, \"\"),\n    \"HLAL\": (\"Wahed FTSE USA Shariah\", \"صندوق مؤشر – أسهم أمريكية\", 0.50, \"\"),\n    \"ISWD\": (\"iShares MSCI World Islamic\", \"صندوق مؤشر – أسهم عالمية\", 0.30, \"مسعّر بالجنيه الإسترليني\"),\n    \"UMMA\": (\"Wahed داو جونز الإسلامي العالمي (خارج أمريكا)\", \"صندوق مؤشر – أسهم دولية\", 0.65, \"يبدأ فبراير 2022\"),\n    \"AMAGX\": (\"أمانة للنمو Amana Growth\", \"صندوق مُدار – أسهم نمو\", 0.87, \"\"),\n    \"AMANX\": (\"أمانة للدخل Amana Income\", \"صندوق مُدار – أسهم توزيعات\", 1.00, \"\"),\n    \"SPRE\": (\"SP Funds للعقار الشرعي\", \"صندوق مؤشر – عقار\", 0.69, \"\"),\n    \"SPSK\": (\"SP Funds للصكوك العالمية\", \"صندوق مؤشر – صكوك\", 0.55, \"\"),\n    \"AMAPX\": (\"أمانة للمشاركة Amana Participation\", \"صندوق مُدار – صكوك\", 0.82, \"\"),\n}\n\ndef stats_monthly(s):\n    r = s.pct_change().dropna()\n    yrs = len(r) / 12\n    tot = s.iloc[-1] / s.iloc[0] - 1\n    return dict(total=tot, cagr=(1 + tot) ** (1 / yrs) - 1, vol=r.std() * np.sqrt(12),\n                maxdd=(s / s.cummax() - 1).min(), y2022=yr(s, 2022), y2023=yr(s, 2023), y2024=yr(s, 2024), y2025=yr(s, 2025),\n                ytd2026=s.iloc[-1] / s[s.index.str.startswith(\"2025-12\")].iloc[0] - 1)\n\ndef yr(s, y):\n    a = s[s.index.str.startswith(f\"{y-1}-12\")]; b = s[s.index.str.startswith(f\"{y}-12\")]\n    return float(b.iloc[0] / a.iloc[0] - 1) if len(a) and len(b) else None\n\ndef load_weekly():\n    frames = {}\n    for t in rs.YIELD:\n        parts = [pd.read_csv(HERE / d / f\"{t}.csv\", parse_dates=[\"date\"]) for d in (\"data_2020\", \"data_gap\", \"data\") if (HERE / d / f\"{t}.csv\").exists()]\n        if not parts or t == \"AMANX\": continue\n        s = pd.concat(parts).drop_duplicates(\"date\", keep=\"last\").set_index(\"date\")[\"close\"].sort_index()\n        frames[t] = s\n    return pd.DataFrame(frames).sort_index()\n\nif __name__ == \"__main__\":\n    rows, curves = [], {}\n    for t, (nm, typ, fee, note) in FUNDS.items():\n        s = pd.read_csv(HERE / \"funds\" / f\"{t}.csv\", dtype={\"month\": str}).set_index(\"month\")[\"adj_close\"]\n        st = stats_monthly(s)\n        rows.append(dict(key=t, name=nm, type=typ, fee=fee / 100, note=note, start=s.index[0], **st))\n        curves[t] = (s / s.iloc[0] * 100).round(2)\n    # strategies on weekly data, window = last Friday of Oct-2021 .. last week available\n    px = rs.total_return(load_weekly())\n    gaps = px.loc[\"2021-10-01\":].isna().sum(); print(\"missing weeks per asset:\", gaps[gaps > 0].to_dict())\n    S = px.index.get_indexer([pd.Timestamp(\"2021-10-25\")], method=\"nearest\")[0]; E = len(px) - 1\n    bt.COST = 0.001\n    strat = {\"shield_v2\": (\"الدرع التكيفي (استراتيجيتنا)\", lambda: rs.run_tranches(px, rs.shield_v2, start=S, end=E)),\n             \"mom_4_3\": (\"مضاربة: زخم أسبوعي – أقوى 3\", lambda: rs.run_single(px, bt.make_momentum(4, 3), 1, start=S, end=E)),\n             \"stocks_ew\": (\"الأسهم السبعة بأوزان متساوية\", lambda: rs.run_single(px, bt.stocks_only_ew, 4, start=S, end=E))}\n    for k, (nm, f) in strat.items():\n        nav, turn = f()\n        m = nav.resample(\"ME\").last(); m.index = m.index.strftime(\"%Y-%m\")\n        st = stats_monthly(m)\n        rows.append(dict(key=k, name=nm, type=\"استراتيجية (اختبار تاريخي)\", fee=None, note=\"بدون رسوم صناديق؛ تكلفة تداول 0.1%\", start=m.index[0], **st))\n        curves[k] = (m / m.iloc[0] * 100).round(2)\n    df = pd.DataFrame(rows).set_index(\"key\").sort_values(\"cagr\", ascending=False)\n    pd.set_option(\"display.width\", 220)\n    show = df.drop(columns=[\"name\", \"type\", \"note\"]).copy()\n    for c in show.columns:\n        if c not in (\"start\",): show[c] = (show[c].astype(float) * 100).round(1)\n    print(show.to_string())\n    json.dump({\"table\": json.loads(df.to_json(orient=\"index\")), \"curves\": {k: v.to_dict() for k, v in curves.items()}},\n              open(HERE / \"funds_results.json\", \"w\"), ensure_ascii=False)\n", "type": "code", "lang": "python"}, {"label": "export_funds.py", "value": "import json\nfrom pathlib import Path\nHERE = Path(__file__).parent; OUT = HERE / \"dashboard\"\nd = json.load(open(HERE / \"funds_results.json\"))\nmeta = [{\"label\": f, \"value\": (HERE / f).read_text(), \"type\": \"code\", \"lang\": \"python\"} for f in (\"funds_compare.py\", \"export_funds.py\")]\nmeta.append({\"label\": \"Input\", \"value\": \"Alpha Vantage monthly adjusted closes (funds/*.csv, distributions reinvested, net of fund fees); strategies: weekly Twelve Data closes with approximate distributions\"})\nr4 = lambda x: None if x is None else round(float(x), 4)\nrows = []\nfor k, v in d[\"table\"].items():\n    rows.append({\"key\": k, \"name\": v[\"name\"], \"type\": v[\"type\"], \"kind\": \"strategy\" if v[\"fee\"] is None else \"fund\",\n                 \"fee\": r4(v[\"fee\"]), \"note\": v[\"note\"], **{c: r4(v[c]) for c in (\"total\", \"cagr\", \"vol\", \"maxdd\", \"y2022\", \"y2023\", \"y2024\", \"y2025\", \"ytd2026\")}})\nrows.sort(key=lambda r: -r[\"cagr\"])\ncurves = [{\"month\": m, \"key\": k, \"value\": val} for k in (\"shield_v2\", \"SPUS\", \"HLAL\", \"AMANX\", \"AMAGX\", \"SPSK\", \"mom_4_3\") for m, val in d[\"curves\"][k].items()]\nhedge = [{\"year\": \"2023\", \"hfri\": 0.075, \"source\": \"HFR (تقدير يناير 2024)\"}, {\"year\": \"2024\", \"hfri\": 0.098, \"source\": \"HFR\"}, {\"year\": \"2025\", \"hfri\": 0.125, \"source\": \"HFR (يناير 2026)\"}]\nfor n, data in ((\"funds_summary\", rows), (\"funds_curves\", curves), (\"hedge_funds\", hedge)):\n    m = meta if n != \"hedge_funds\" else [{\"label\": \"Source\", \"value\": \"HFRI Fund Weighted Composite: hfr.com year-end releases (2023 +7.5% est., 2024 +9.8%, 2025 +12.5%). 2022 not confirmed.\"}]\n    (OUT / f\"{n}.json\").write_text(json.dumps({\"rows\": data, \"meta\": m}, ensure_ascii=False)); print(n, len(data))\n", "type": "code", "lang": "python"}, {"label": "Input", "value": "Alpha Vantage monthly adjusted closes (funds/*.csv, distributions reinvested, net of fund fees); strategies: weekly Twelve Data closes with approximate distributions"}]}
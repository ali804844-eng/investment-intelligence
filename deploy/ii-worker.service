[Unit]
Description=Investment Intelligence research worker (scheduler + job queue)
After=network-online.target postgresql.service ii-api.service

[Service]
User=ii
WorkingDirectory=/opt/investment-intelligence/backend
EnvironmentFile=/opt/investment-intelligence/.env
ExecStart=/opt/investment-intelligence/backend/.venv/bin/python -m app.worker.runner
Restart=always
RestartSec=10
TimeoutStopSec=90
NoNewPrivileges=true
ProtectSystem=strict
ReadWritePaths=/tmp

[Install]
WantedBy=multi-user.target
